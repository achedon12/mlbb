{
  "name": "mlbb",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile Legends: Bang Bang knowledge base in English, French, Italian, Spanish and Indonesian: heroes, builds, counters, tier lists, patch notes and tools.",
  "author": "achedon12 <82544800+achedon12@users.noreply.github.com> (https://github.com/achedon12)",
  "license": "MIT",
  "homepage": "https://mlbbdex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achedon12/mlbb.git"
  },
  "bugs": {
    "url": "https://github.com/achedon12/mlbb/issues"
  },
  "keywords": [
    "mobile-legends",
    "mlbb",
    "moba",
    "tier-list",
    "game-data",
    "nextjs",
    "typescript",
    "i18n"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync.mjs",
    "sync:evolution": "node scripts/sync.mjs --evolution",
    "sync:events": "node scripts/events.mjs",
    "sync:advance-server": "node scripts/advance-server.mjs",
    "sync:esports": "node scripts/esports.mjs",
    "translate": "node scripts/translate-messages.mjs && node scripts/translate-data.mjs && node scripts/translate-articles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "watch": "node scripts/watch.mjs",
    "translate:messages": "node scripts/translate-messages.mjs",
    "translate:data": "node scripts/translate-data.mjs",
    "translate:articles": "node scripts/translate-articles.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.12.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "next": "^16.4.5",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.10.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
