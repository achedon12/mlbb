# URL publique, utilisee par les liens canoniques, le plan du site et le flux
# RSS. Sans slash final.
NEXT_PUBLIC_SITE_URL=https://mlbbdex.com

# Dossier des journaux applicatifs (erreurs serveur et navigateur), range par
# jour. Par defaut « logs » a la racine. En conteneur, un volume dedie.
LOGS_DIR=logs

# Facultatif : mesure d'audience Matomo, configuree sans cookie. Renseigner les
# deux variables active le traceur ; l'URL pointe l'instance Matomo auto-hebergee
# (ex. https://leoderoin.fr), l'identifiant est celui du site dans Matomo.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Facultatif : notifications de patch (Web Push) pour les heros favoris. Sans
# ces trois variables, la fonction est masquee et rien d'autre ne change. Lues
# a l'execution : pas besoin de reconstruire l'image pour les poser.
#   npx web-push generate-vapid-keys
# donne une cle publique et une cle privee, a reporter ci-dessous. Les garder
# pour toujours : en changer rend caducs tous les abonnements existants.
# VAPID_SUBJECT est un contact pour les services de notification
# (mailto:adresse ou https://site).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Dossier des donnees du serveur : abonnements aux notifications et dernier
# patch annonce. Par defaut « donnees-serveur » ; en conteneur, un volume.
DONNEES_DIR=donnees-serveur

# Facultatif : jeton (24 caracteres ou plus) de la route d'essai
# POST /api/push/envoi ; sans lui, la route n'existe pas. Ex. : openssl rand -hex 32
PUSH_ADMIN_TOKEN=

# Optional: token (24 characters or more) that lets the administrator delete any
# community build with DELETE /api/builds/<id> and `Authorization: Bearer <token>`.
# Without it, only authors can delete their own builds. Ex.: openssl rand -hex 32
BUILDS_ADMIN_TOKEN=
