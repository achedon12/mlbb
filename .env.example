# Public URL, used by canonical links, the sitemap and the RSS feed. No
# trailing slash.
NEXT_PUBLIC_SITE_URL=https://mlbbdex.com

# Reverse proxies in front of the app that append to X-Forwarded-For (1:
# nginx). The client address used by the rate limits is the entry that many
# places from the right; the entries before it are the client's own claim.
# 0 when the app is reached directly (no header trusted).
TRUSTED_PROXY_HOPS=1

# Application log folder (server and browser errors), split by day. Defaults
# to "logs" at the root. In a container, a dedicated volume.
LOGS_DIR=logs

# Optional: Matomo audience measurement, configured without cookies. Setting
# both variables enables the tracker; the URL points to the self-hosted Matomo
# instance (e.g. https://leoderoin.fr), the id is the site's id in Matomo.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Optional: counting the public API calls (/api/v1/*) made by scripts and other
# sites, which the browser tracker never sees. The server reports each call to
# the Matomo of NEXT_PUBLIC_MATOMO_URL, on a site of its own so API traffic
# does not mix with the visitors. Read at runtime: no rebuild needed.
#   1. In Matomo, Administration > Websites > Manage > Add a new website, named
#      "MLBBDex API", URL https://mlbbdex.com; its id goes in MATOMO_API_SITE_ID.
#      Without it, nothing is sent.
#   2. Optional but recommended: Administration > System > Users > Add a new
#      user (e.g. "mlbbdex-api"), with the "Write" permission on that site only
#      and no other access; then, logged in as that user, Personal > Security >
#      Create new token, and copy it into MATOMO_API_TOKEN. With it, Matomo
#      sees each caller's address (anonymised by its own settings) and tells
#      consumers apart; without it, every call looks like it comes from the
#      server. The token is only ever sent to Matomo, never logged.
# Calls sent with DNT: 1 or Sec-GPC: 1 are not counted. No cookie either way.
MATOMO_API_SITE_ID=
MATOMO_API_TOKEN=

# Number of reverse proxies in front of the server that append to
# X-Forwarded-For. The caller's address is read that many entries from the
# right: the entries before it are written by the caller and can be forged.
# Defaults to 1, the nginx in front of the container; 2 behind a CDN plus
# nginx; 0 when nothing sits in front (the address is then unknown, since no
# header can be trusted).
TRUSTED_PROXY_HOPS=1

# Optional: patch notifications (Web Push) for favorite heroes. Without these
# three variables, the feature is hidden and nothing else changes. Read at
# runtime: no need to rebuild the image to set them.
#   npx web-push generate-vapid-keys
# gives a public key and a private key, to copy below. Keep them forever:
# changing them voids every existing subscription.
# VAPID_SUBJECT is a contact for the notification services
# (mailto:address or https://site).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Server data folder: notification subscriptions and last announced patch.
# Defaults to "donnees-serveur"; in a container, a volume.
DATA_DIR=donnees-serveur

# Optional: token (24 characters or more) for the test route
# POST /api/push/send; without it, the route does not exist. Ex.: openssl rand -hex 32
PUSH_ADMIN_TOKEN=

# Optional: token (24 characters or more) that lets the administrator delete any
# community build with DELETE /api/builds/<id> and `Authorization: Bearer <token>`.
# Without it, only authors can delete their own builds. Ex.: openssl rand -hex 32
BUILDS_ADMIN_TOKEN=

# Community (forum and teammate finder, docs/community.md): needs DATABASE_URL
# (the bot's Postgres); without it the pages say the community is
# unavailable. Moderators are the BOT_SUPER_ADMIN_IDS, signed in with Discord
# at /community/moderation. Optional: extra words the forum refuses,
# comma-separated, on top of the built-in list. Read at runtime.
COMMUNITY_BLOCKED_WORDS=

# ── Discord bot (optional) ───────────────────────────────────────────
# See docs/discord-bot.md. Without these variables, every bot page answers
# 404, the internal API /api/bot/* too, and nothing else changes. The
# docker-compose `bot` profile starts the database and the bot process:
#   COMPOSE_PROFILES=bot
COMPOSE_PROFILES=

# Public values, inlined in the pages at build time (Docker build arguments):
# the application id from the Discord developer portal (General Information),
# for the "Add to Discord" button, and the permanent invite of the community
# server (https://discord.gg/...), shown in the header, the footer and /bot.
# The invite link works on its own, even without the bot.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/mw5RzvkkU3

# Postgres, for the bot data only. The password is the compose database's;
# the address points to it on the internal network. Only the site gets it.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://mlbbdex:<POSTGRES_PASSWORD>@postgres:5432/mlbbdex

# Shared secret of the signed calls between the site and the bot, both ways
# (HMAC-SHA256). The same value on both sides, 32 random bytes or more:
#   openssl rand -hex 32
BOT_API_SECRET=
# The bot's internal HTTP server, on the compose internal network.
BOT_INTERNAL_URL=http://bot:3100

# Dashboard login with Discord (OAuth2, scope identify). Client id and secret
# from the developer portal (OAuth2 page); add the redirect URL
# <NEXT_PUBLIC_SITE_URL>/api/discord/callback there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Encrypts the dashboard session cookie, 32 random bytes or more. Changing it
# signs everyone out.
#   openssl rand -hex 32
BOT_SESSION_SECRET=
# Discord user ids allowed into the super admin panel, comma-separated
# (Discord: Settings > Advanced > Developer mode, then "Copy user ID").
BOT_SUPER_ADMIN_IDS=

# Optional: vote webhooks of the bot lists, at /api/bot/votes/topgg and
# /api/bot/votes/dbl. The secret is the one typed in the list's webhook
# settings (top.gg: "Authorization"); without it the route answers 404.
#   openssl rand -hex 24
TOPGG_WEBHOOK_SECRET=
DBL_WEBHOOK_SECRET=

# Bot process only (passed to the bot container one by one, never to the
# site): its token from the developer portal (Bot page), and the optional
# tokens of the bot lists it posts its server count to.
DISCORD_TOKEN=
TOPGG_TOKEN=
DBL_TOKEN=
DBOTSGG_TOKEN=
