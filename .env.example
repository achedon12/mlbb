# URL publique, utilisee par les liens canoniques, le plan du site et le flux
# RSS. Sans slash final.
NEXT_PUBLIC_SITE_URL=https://mlbbdex.com

# Facultatif : permet a la synchronisation de retrouver la presentation video
# officielle de chaque heros sur YouTube. Sans cette cle, les fiches proposent
# un lien de recherche au lieu d'un lecteur.
# Cle gratuite : https://console.cloud.google.com — activer YouTube Data API v3
YOUTUBE_API_KEY=

# Dossier des journaux applicatifs (erreurs serveur et navigateur), range par
# jour. Par defaut « logs » a la racine. En conteneur, un volume dedie.
LOGS_DIR=logs

# Facultatif : mesure d'audience Matomo, configuree sans cookie. Renseigner les
# deux variables active le traceur ; l'URL pointe l'instance Matomo auto-hebergee
# (ex. https://leoderoin.fr), l'identifiant est celui du site dans Matomo.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
