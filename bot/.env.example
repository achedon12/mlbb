# MLBBDex Discord bot. Copy to bot/.env for local runs; in production the
# values come from the compose file. Never commit real values.

# ── Discord (https://discord.com/developers/applications) ────────────────
# Bot token (Bot tab). Required: the bot stops at start without it.
DISCORD_TOKEN=
# Application id (General Information tab). Required.
DISCORD_CLIENT_ID=
# Optional: register the commands on this one server only (instant, for
# testing) instead of globally, when running `npm run deploy-commands`.
DEV_GUILD_ID=

# ── Site ──────────────────────────────────────────────────────────────────
# Shared secret for the signed calls between the bot and the site, the same
# value on both sides. At least 32 random bytes: openssl rand -hex 32
# Without it the bot only answers game-data commands (no settings, no
# announcements, no daily games, no internal API).
BOT_API_SECRET=
# Public site: game data (/api/v1/*) and the links in every reply.
SITE_URL=https://mlbbdex.com
# The site as reached from the bot's container, for /api/bot/*.
SITE_INTERNAL_URL=http://mlbb:3001

# ── Internal HTTP server (called by the site only) ───────────────────────
# Bind address: 0.0.0.0 inside docker (the port is not published), 127.0.0.1 elsewhere.
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=3100

# ── Bot lists (each optional: no token, no stats posted) ─────────────────
TOPGG_TOKEN=
DBL_TOKEN=
DBOTSGG_TOKEN=

# ── Links ─────────────────────────────────────────────────────────────────
# Permanent invite of the community server, shown by /help and /about.
SUPPORT_SERVER_URL=
# The community server's id: replies there do not offer "Add to your
# server" (its members already have the bot). Empty: offered everywhere.
SUPPORT_GUILD_ID=

# debug | info | warn | error (default info)
LOG_LEVEL=info
