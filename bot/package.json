{
  "name": "mlbbdex-bot",
  "version": "1.0.0",
  "private": true,
  "description": "MLBBDex Discord bot: heroes, builds, counters, tier lists, patch notes and the daily MLBBdle and quiz from mlbbdex.com, in five languages.",
  "author": "achedon12 <82544800+achedon12@users.noreply.github.com> (https://github.com/achedon12)",
  "license": "MIT",
  "homepage": "https://mlbbdex.com/en/bot",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "deploy-commands": "npm run build && node --env-file-if-exists=.env dist/deploy-commands.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
