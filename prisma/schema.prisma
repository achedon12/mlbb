// Discord bot data (see docs/discord-bot.md). Only the site reads and
// writes it: the bot goes through the signed internal API.
//
// Every Discord id is a snowflake kept as text (up to 20 digits): a 64-bit
// integer would not survive JSON on the way to the bot.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A server the bot is (or was) in. `leftAt` set: the bot left; its rows are
/// deleted 30 days later, so a re-invite within that time keeps the settings.
model Guild {
  id          String    @id @db.VarChar(20)
  name        String    @db.VarChar(100)
  icon        String?   @db.VarChar(64)
  memberCount Int       @default(0)
  /// One of the site languages: en, fr, it, es, id.
  locale      String    @default("en") @db.VarChar(2)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  updatedAt   DateTime  @updatedAt

  settings   GuildSettings?
  deliveries Delivery[]
  roleMenus  RoleMenu[]

  @@index([leftAt])
  /// Joins per day, in the admin panel.
  @@index([joinedAt])
}

/// Per-server settings. A null channel turns the announcement type off;
/// `<type>Failing` is set when the bot could not post there (permissions
/// lost) and cleared when the settings are saved again. The welcome and
/// goodbye messages work the same way: a null channel turns them off, a
/// null message posts the default text in the server's language. Auto-roles
/// too: an empty list turns them off, and saving clears their failing flag.
model GuildSettings {
  guildId String @id @db.VarChar(20)
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  patchesChannelId       String? @db.VarChar(20)
  patchesRoleId          String? @db.VarChar(20)
  patchesFailing         Boolean @default(false)
  skinsChannelId         String? @db.VarChar(20)
  skinsRoleId            String? @db.VarChar(20)
  skinsFailing           Boolean @default(false)
  eventsChannelId        String? @db.VarChar(20)
  eventsRoleId           String? @db.VarChar(20)
  eventsFailing          Boolean @default(false)
  advanceServerChannelId String? @db.VarChar(20)
  advanceServerRoleId    String? @db.VarChar(20)
  advanceServerFailing   Boolean @default(false)
  esportsChannelId       String? @db.VarChar(20)
  esportsRoleId          String? @db.VarChar(20)
  esportsFailing         Boolean @default(false)

  dailyMlbbdleChannelId String? @db.VarChar(20)
  dailyQuizChannelId    String? @db.VarChar(20)
  /// Hour of the daily games post, 0 to 23, UTC.
  dailyHourUtc          Int     @default(12)

  /// Posted when a member joins (`guildMemberAdd`). The text is the owner's
  /// own, with placeholders, at most 500 characters; nothing about the
  /// member is stored.
  welcomeChannelId String? @db.VarChar(20)
  welcomeMessage   String? @db.VarChar(500)
  welcomeFailing   Boolean @default(false)
  /// Posted when a member leaves (`guildMemberRemove`).
  goodbyeChannelId String? @db.VarChar(20)
  goodbyeMessage   String? @db.VarChar(500)
  goodbyeFailing   Boolean @default(false)

  /// Roles given to a person who joins (`guildMemberAdd`, or once they pass
  /// the server's membership screening), at most 3; empty, the default,
  /// turns auto-roles off. Each was checked against what the bot may give
  /// when saved, and is checked again by the bot before every assignment.
  autoRoleIds     String[] @default([]) @db.VarChar(20)
  /// Same, for the bots added to the server (never the people's roles).
  botAutoRoleIds  String[] @default([]) @db.VarChar(20)
  /// The bot could not give them (Manage Roles lost, a role moved above it).
  autoRoleFailing Boolean  @default(false)
  /// Why: "bot" (the bot may not give them) or "granter" (the manager below).
  autoRoleFailReason    String? @db.VarChar(16)
  /// Discord id of the manager who chose the roles. The bot gives only what
  /// that person could give themselves (Manage Roles, roles below theirs, or
  /// owner), checked again before every assignment.
  autoRolesConfiguredBy String? @db.VarChar(20)

  updatedAt DateTime @updatedAt

  /// The hourly daily-post round reads one hour's servers only.
  @@index([dailyHourUtc])
}

/// A self-assign role menu: a message the bot posts in `channelId` (an
/// embed, a select menu of the roles, a "remove my roles" button) for the
/// members to pick their roles themselves. `mode`: "single" (picking one
/// removes the menu's others: ranks) or "multiple". At most 10 per server.
model RoleMenu {
  id               Int       @id @default(autoincrement())
  guildId          String    @db.VarChar(20)
  guild            Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId        String    @db.VarChar(20)
  title            String    @db.VarChar(100)
  description      String?   @db.VarChar(1000)
  mode             String    @default("single") @db.VarChar(8)
  /// `[{ roleId, label, emoji }]`, 1 to 25, in the menu's order; `emoji` a
  /// unicode emoji or `<:name:id>` of the server, or null. Each role was
  /// checked against what the bot and the saver may give when saved, and
  /// is checked again by the bot before every change.
  options          Json
  /// Discord id of the manager who chose the roles. The bot gives only what
  /// that person could give themselves (Manage Roles, roles below theirs, or
  /// owner), checked again before every change.
  configuredBy     String    @db.VarChar(20)
  /// The message the bot posted, and its channel; null until published.
  messageId        String?   @db.VarChar(20)
  messageChannelId String?   @db.VarChar(20)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([guildId])
}

/// Something worth posting, detected in the site's own data. Unique by
/// (type, key): detecting it again changes nothing. `silent`: recorded on the
/// first detection of its type, as a baseline, and never delivered.
model Announcement {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(16)
  key       String   @db.VarChar(120)
  payload   Json
  silent    Boolean  @default(false)
  createdAt DateTime @default(now())

  deliveries Delivery[]

  @@unique([type, key])
  @@index([createdAt])
}

/// One announcement in one server: present once the bot tried, so a restart
/// never posts twice.
model Delivery {
  announcementId Int
  guildId        String       @db.VarChar(20)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  guild          Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// sent, failed or forbidden.
  status         String       @db.VarChar(16)
  messageId      String?      @db.VarChar(20)
  error          String?      @db.VarChar(300)
  sentAt         DateTime     @default(now())

  @@id([announcementId, guildId])
  /// A server's last deliveries, newest first (its dashboard).
  @@index([guildId, sentAt])
  @@index([sentAt])
}

/// One command run. No user id: counts only.
model CommandLog {
  id         Int      @id @default(autoincrement())
  command    String   @db.VarChar(32)
  guildId    String?  @db.VarChar(20)
  locale     String   @db.VarChar(8)
  durationMs Int
  ok         Boolean
  createdAt  DateTime @default(now())

  /// Every admin figure reads a window of time; nothing filters on the
  /// command alone, so it has no index of its own (a hot insert path).
  @@index([createdAt])
}

/// A player's result at a daily game in a server, for its leaderboards.
/// `score`: guesses for MLBBdle (lower is better), points for the quiz.
model DailyResult {
  guildId         String   @db.VarChar(20)
  /// UTC day, YYYY-MM-DD, the same day as the site's puzzle.
  day             String   @db.VarChar(10)
  /// mlbbdle-classic, mlbbdle-skill or quiz.
  game            String   @db.VarChar(16)
  discordUserId   String   @db.VarChar(20)
  discordUserName String   @db.VarChar(64)
  score           Int
  createdAt       DateTime @default(now())

  @@id([guildId, day, game, discordUserId])
  /// Leaderboards: one server, one game, a range of days.
  @@index([guildId, game, day])
  /// Players per day, in the admin panel.
  @@index([day])
}

/// A vote on a bot list (top.gg, discordbotlist.com), for the admin stats.
model Vote {
  id            Int      @id @default(autoincrement())
  list          String   @db.VarChar(16)
  discordUserId String   @db.VarChar(20)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ── Community: forum and teammate finder (docs/community.md) ─────────────
//
// Authors are game accounts, kept as `accountId`: the 24-character hash of
// the in-game id and server (src/lib/community-builds-server.ts), never the
// ids themselves. Moderators are Discord ids listed in BOT_SUPER_ADMIN_IDS.

/// A game account that wrote, voted or reported in the community. Created on
/// its first action: `firstSeenAt` drives the new-account limits. `bannedAt`
/// set: the account may no longer post, vote, report or list a card (until
/// `banUntil`, or for good when it is null).
model CommunityMember {
  accountId   String    @id @db.VarChar(24)
  name        String    @db.VarChar(40)
  firstSeenAt DateTime  @default(now())
  bannedAt    DateTime?
  banUntil    DateTime?
  banReason   String?   @db.VarChar(300)
  /// Discord id of the moderator who banned the account.
  bannedBy    String?   @db.VarChar(20)

  @@index([bannedAt])
}

/// A forum thread. Its opening post is the thread itself (`body`, Markdown,
/// rendered through the sanitizer). `heroes`: up to 5 hero slugs, shown as
/// tags linking to the hero pages. `hiddenAt`: hidden by a moderator or by
/// reports, pending review. `deletedAt`: deleted by its author or a
/// moderator, its text erased. `lastPostAt` orders the "latest" view.
model ForumThread {
  id         Int       @id @default(autoincrement())
  category   String    @db.VarChar(24)
  title      String    @db.VarChar(120)
  body       String
  heroes     String[]  @default([]) @db.VarChar(40)
  authorId   String    @db.VarChar(24)
  authorName String    @db.VarChar(40)
  score      Int       @default(0)
  replyCount Int       @default(0)
  pinned     Boolean   @default(false)
  locked     Boolean   @default(false)
  hiddenAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  lastPostAt DateTime  @default(now())

  posts ForumPost[]

  /// Category pages, "latest" and "top" orders (pinned threads first).
  @@index([category, pinned, lastPostAt])
  @@index([category, pinned, score])
  @@index([lastPostAt])
  /// Daily caps per account.
  @@index([authorId, createdAt])
}

/// A reply in a thread, Markdown like the thread's body.
model ForumPost {
  id         Int         @id @default(autoincrement())
  threadId   Int
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body       String
  authorId   String      @db.VarChar(24)
  authorName String      @db.VarChar(40)
  score      Int         @default(0)
  hiddenAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  editedAt   DateTime?

  /// A thread's replies, in order.
  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

/// One upvote per account and per thread or reply (`kind`: thread or post).
model ForumVote {
  kind      String   @db.VarChar(8)
  targetId  Int
  voterId   String   @db.VarChar(24)
  createdAt DateTime @default(now())

  @@id([kind, targetId, voterId])
}

/// A report on a thread, a reply or a teammate card (`kind`: thread, post,
/// card), one per account and target. Open while `resolvedAt` is null: that
/// is the moderation queue. Enough open reports hide the target until a
/// moderator looks at it.
model CommunityReport {
  id         Int       @id @default(autoincrement())
  kind       String    @db.VarChar(8)
  targetId   Int
  reporterId String    @db.VarChar(24)
  /// spam, abuse, offtopic, personal or other.
  reason     String    @db.VarChar(16)
  note       String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  /// Discord id of the moderator who closed it.
  resolvedBy String?   @db.VarChar(20)

  @@unique([kind, targetId, reporterId])
  @@index([resolvedAt, createdAt])
}

/// What a moderator did, for the record: hide, unhide, delete, lock, unlock,
/// pin, unpin, ban, unban, dismiss.
model ModerationLog {
  id            Int      @id @default(autoincrement())
  moderatorId   String   @db.VarChar(20)
  moderatorName String   @db.VarChar(64)
  action        String   @db.VarChar(16)
  kind          String?  @db.VarChar(8)
  targetId      Int?
  /// The account acted upon (the target's author, or the one banned).
  accountId     String?  @db.VarChar(24)
  note          String?  @db.VarChar(300)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// A "looking for teammates" card, one per account, listed for 7 days
/// (`expiresAt`). `gameId` and `discord` are optional and only shown to
/// signed-in players.
model TeammateCard {
  id         Int       @id @default(autoincrement())
  accountId  String    @unique @db.VarChar(24)
  authorName String    @db.VarChar(40)
  region     String    @db.VarChar(12)
  rank       String    @db.VarChar(20)
  lanes      String[]  @default([]) @db.VarChar(8)
  heroes     String[]  @default([]) @db.VarChar(40)
  languages  String[]  @default([]) @db.VarChar(4)
  playTimes  String[]  @default([]) @db.VarChar(12)
  note       String?   @db.VarChar(200)
  gameId     String?   @db.VarChar(24)
  discord    String?   @db.VarChar(40)
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
